{
  "name": "diechi-app",
  "version": "1.0.0",
  "description": "蝶翅智能AI助手 - 基于DeepSeek Harness插件化架构的多模态AI助手",
  "main": "index.js",
  "scripts": {
    "web:dev": "cd apps/web && pnpm dev",
    "web:build": "cd apps/web && pnpm build",
    "web:preview": "cd apps/web && pnpm preview",
    "api:dev": "cd apps/api && source venv/bin/activate && uvicorn main:app --reload --port 8000",
    "api:start": "cd apps/api && source venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"npm run web:dev\" \"npm run api:dev\"",
    "build": "cd apps/web && pnpm build",
    "start": "npm run api:start",
    "lint": "cd apps/web && pnpm lint",
    "format": "cd apps/web && pnpm format",
    "test": "cd apps/web && pnpm test",
    "test:api": "cd apps/api && source venv/bin/activate && pytest"
  },
  "keywords": [
    "AI",
    "语音识别",
    "多模态",
    "插件化",
    "DeepSeek Harness"
  ],
  "author": "AI助手开发团队",
  "license": "Apache-2.0",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "pnpm": ">=8.0.0",
    "python": ">=3.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vibechina/diechi-app.git"
  },
  "bugs": {
    "url": "https://github.com/vibechina/diechi-app/issues"
  },
  "homepage": "https://github.com/vibechina/diechi-app#readme",
  "workspaces": [
    "apps/*",
    "models/*"
  ],
  "packageManager": "pnpm@8.14.0",
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    }
  }
}